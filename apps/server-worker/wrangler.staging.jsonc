{
  // $schema: ../node_modules/wrangler/config-schema.json
  // Staging deployment (#31): same composed entry as wrangler.jsonc, with the
  // real staging D1 and the composition vars baked. Relay catalog (#361
  // cutover, 2026-10-06): newapi openai-responses adaptor, glm-5.3-flash —
  // replaces the direct open.bigmodel.cn anthropic secret (zhipu account
  // quota wall 429/1310; the 10-04 "anthropic truncation" misdiagnosis was
  // corrected same day — newapi anthropic SSE completes with message_stop).
  // #450 the catalog 正本 is the D1 provider_configs rows (the panel's CRUD
  // face); the env seed and its credentials secret are retired — seed the
  // newapi row through POST /api/v1/system/providers instead.
  "name": "cap-server-staging",
  "main": "src/index.ts",
  // #412 cutover step 1（cf-access-agent-compat.md §8；域名用户裁决 2026-10-06：
  // bb-staging.samuka007.com——.com zone 已有 cvat/langfuse Access 先例）。
  // #411/#412 后 edge Access root app「cap-staging」覆盖整域；workers.dev 路由
  // 已随自定义域接管停用（CF 1042，#480）——本域是唯一活面。
  "routes": [{ "pattern": "bb-staging.samuka007.com", "custom_domain": true }],
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cap-control-plane",
      "database_id": "4e823d64-cc93-4922-b576-ec1a455c02aa",
    },
    {
      // #62 liveness projection: daemon heartbeats stamp hosts.last_seen_at
      // (bb markHostSeen). Same database as DB; explicit DO seam binding.
      "binding": "HOSTS_DB",
      "database_name": "cap-control-plane",
      "database_id": "4e823d64-cc93-4922-b576-ec1a455c02aa",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "NotificationHubDO" },
      { "name": "LEASES", "class_name": "LeaseStoreDO" },
      { "name": "AGENT_DO", "class_name": "ComposedAgentDO" },
      { "name": "ORCHESTRATOR", "class_name": "ComposedHostOrchestratorDO" },
      { "name": "MANAGER", "class_name": "ManagerDo" },
      { "name": "DAEMON_SERVICE", "class_name": "DaemonServiceDO" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NotificationHubDO",
        "LeaseStoreDO",
        "ComposedAgentDO",
        "ComposedHostOrchestratorDO",
        "ManagerDo",
        "DaemonServiceDO",
      ],
    },
  ],
  "r2_buckets": [
    {
      // #316 project attachment objects (key family
      // attachment/<projectId>/<sha256><ext>). Provision with
      // `wrangler r2 bucket create cap-server-attachments` before deploy.
      "binding": "BLOBS",
      "bucket_name": "cap-server-attachments",
    },
  ],
  "kv_namespaces": [
    {
      // Edge shield (#36): hostKey-hash auth cache for the composed daemon
      // face. Optional at runtime (env-key deployments skip it). Staging
      // redeploy (#36) picks this up with no migration.
      "binding": "DAEMON_EDGE_KV",
      "id": "5b39e87d559b424a8f6432e6a2bc9ff7",
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    // SEC-W5-001 (#397) fail-closed, #505: no gate flag — gate state IS the
    // ACCESS_TEAM_DOMAIN + ACCESS_AUD Worker secret pair (`wrangler secret
    // put`); both present = the gate verifies Access JWTs on /api/v1/* and
    // /ws, either missing = the control plane locks (503
    // access_gate_disabled; SPA/static assets stay public).
    // scripts/deploy-staging.sh asserts the pair before every deploy.
    // #504: DATA_DIR retired — the display label is the named constant
    // BB_DATA_DIR_LABEL (shared/bb-display.ts), never a knob.
    // #377: identity vars removed — no synthetic host. Zero enrolled hosts
    // is a first-class state: the binding default is the cloud placeholder
    // and /hosts stays honestly empty. Real machines join through enroll
    // (join code, or the env key minting a fresh host).
    // #500: the deployment-channel vars (the relay scalars, the thinking
    // budget, the machine pin, the permission mode) are deleted — the D1
    // provider_configs rows carry window/input per model, and the
    // permission_mode seat carries the posture. #534: the ladder is the row's
    // pi thinking seat (reasoning + thinking.efforts — no budget scalar
    // anywhere; #303's one-rung posture = efforts: ["medium"], hot-applied,
    // no redeploy).
  },
}
