{
  // $schema: node_modules/wrangler/config-schema.json
  "name": "cap-server-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cap-control-plane",
      // Undeployed placeholder in M0 (ticket #26: no CF credentials assumed);
      // staging provisioning substitutes the real database id (#31).
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "NotificationHubDO" },
      { "name": "LEASES", "class_name": "LeaseStoreDO" },
      // Per-thread event log + turn state (#29), composed wrapper for
      // per-isolate relay registration (#31).
      { "name": "AGENT_DO", "class_name": "ComposedAgentDO" },
      // Per-host command journal + session mirror (#27), composed wrapper
      // for in-isolate adapter installation (#31).
      { "name": "ORCHESTRATOR", "class_name": "ComposedHostOrchestratorDO" },
      // Provider session registry + harness (#28).
      { "name": "MANAGER", "class_name": "ManagerDo" },
      // Per-machine daemon service DO (#30) — client WS face + exec journal.
      { "name": "DAEMON_SERVICE", "class_name": "DaemonServiceDO" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NotificationHubDO",
        "LeaseStoreDO",
        "ComposedAgentDO",
        "ComposedHostOrchestratorDO",
        "ManagerDo",
        "DaemonServiceDO",
      ],
    },
  ],
  "kv_namespaces": [
    {
      // Edge shield (#36): hostKey-hash auth cache for the composed daemon
      // face. Optional at runtime (env-key deployments skip it).
      "binding": "DAEMON_EDGE_KV",
      "id": "5b39e87d559b424a8f6432e6a2bc9ff7",
    },
  ],
  "triggers": {
    // Backstop sweep; per-item timing rides DO alarms (bb ran a 10s
    // in-process sweep).
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    // Staging flag: flip to "true" (with ACCESS_TEAM_DOMAIN + ACCESS_AUD
    // secrets set) once the Worker fronts real Cloudflare Access.
    "ACCESS_CHECK_ENABLED": "false",
    "DATA_DIR": "/data",
    // Composition identity (#31): journal host / machine name — must match
    // the daemon client's enrolled hostId and the harness machineId so the
    // client WS and the agent seam meet on the same per-machine DO.
    "ORCHESTRATOR_HOST_ID": "local",
    "DAEMON_HOST_ID": "local",
    "DAEMON_MACHINE_ID": "local",
  },
}
