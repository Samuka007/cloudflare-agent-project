{
  // $schema: node_modules/wrangler/config-schema.json
  "name": "cap-server-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cap-control-plane",
      // Undeployed placeholder in M0 (ticket #26: no CF credentials assumed);
      // staging provisioning substitutes the real database id (#31).
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
    {
      // #62 liveness projection: the per-host daemon service DO stamps the
      // registry's last_seen_at on daemon heartbeats (bb markHostSeen).
      // Same database as DB; the second binding keeps the DO seam explicit.
      "binding": "HOSTS_DB",
      "database_name": "cap-control-plane",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "NotificationHubDO" },
      { "name": "LEASES", "class_name": "LeaseStoreDO" },
      // Per-thread event log + turn state (#29), composed wrapper for
      // per-isolate relay registration (#31).
      { "name": "AGENT_DO", "class_name": "ComposedAgentDO" },
      // Per-host command journal + session mirror (#27), composed wrapper
      // for in-isolate adapter installation (#31).
      { "name": "ORCHESTRATOR", "class_name": "ComposedHostOrchestratorDO" },
      // Provider session registry + harness (#28).
      { "name": "MANAGER", "class_name": "ManagerDo" },
      // Per-machine daemon service DO (#30) — client WS face + exec journal.
      { "name": "DAEMON_SERVICE", "class_name": "DaemonServiceDO" },
    ],
  },
  "r2_buckets": [
    {
      // #316 project attachment objects (key family
      // attachment/<projectId>/<sha256><ext>). Provision with
      // `wrangler r2 bucket create cap-server-attachments` before deploy.
      "binding": "BLOBS",
      "bucket_name": "cap-server-attachments",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NotificationHubDO",
        "LeaseStoreDO",
        "ComposedAgentDO",
        "ComposedHostOrchestratorDO",
        "ManagerDo",
        "DaemonServiceDO",
      ],
    },
  ],
  "kv_namespaces": [
    {
      // Edge shield (#36): hostKey-hash auth cache for the composed daemon
      // face. Optional at runtime (env-key deployments skip it).
      "binding": "DAEMON_EDGE_KV",
      "id": "5b39e87d559b424a8f6432e6a2bc9ff7",
    },
  ],
  "triggers": {
    // Backstop sweep; per-item timing rides DO alarms (bb ran a 10s
    // in-process sweep).
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    // SEC-W5-001 (#397) fail-closed, #505: no gate flag — gate state IS the
    // ACCESS_TEAM_DOMAIN + ACCESS_AUD Worker secret pair (`wrangler secret
    // put`). Both present = JWT verification on /api/v1/* and /ws; either
    // missing = locked (503 access_gate_disabled) unless local-dev
    // (ACCESS_LOCAL_DEV, never set here). deploy-staging.sh asserts the pair.
    "DATA_DIR": "/data",
    // #377: no composition identity vars. The provider journal DO is named
    // by a code constant, the binding default is the cloud placeholder, and
    // a daemon enroll mints its own host — the deployment fabricates no
    // machine. (DAEMON_MACHINE_ID may be set deliberately to pin the harness
    // host binding to a real machine name; unset = the placeholder.)
  },
}
