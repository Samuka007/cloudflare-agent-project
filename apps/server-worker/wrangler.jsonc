{
  // $schema: node_modules/wrangler/config-schema.json
  "name": "cap-server-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  // #602: @cap/agent-durable statically imports its drizzle-kit generated
  // journal DDL as text (src/db/bootstrap.ts) — this worker bundles that
  // source, so the loader rule must ride the deploy config too.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      // W6 db campaign (#591/#594): the drizzle-era control plane
      // (src/db/schema.ts → drizzle/ ledger, applied by the deploy hook —
      // see wrangler.staging.jsonc for the phase note). Placeholder id in
      // the undeployed default config; the vitest rig uses it as the local
      // D1 (env.DB_V2) for the ledger-migration suite. Staging provisioning
      // substitutes the real id in wrangler.staging.jsonc.
      "binding": "DB_V2",
      "database_name": "cap-control-plane-v2",
      // Zero placeholder: never collides with any deployed database id.
      // Never deployed (staging uses the real id).
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "drizzle",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "NotificationHubDO" },
      { "name": "LEASES", "class_name": "LeaseStoreDO" },
      // The one per-thread pi-durable agent.
      { "name": "AGENT_DO", "class_name": "ComposedDurableAgentDO" },
      // Per-machine daemon service DO (#30) — client WS face + exec journal.
      { "name": "DAEMON_SERVICE", "class_name": "DaemonServiceDO" },
    ],
  },
  "services": [
    {
      // T7 #599: the ControlPlane typed RPC face — a self service binding
      // to this worker's `control_plane` named entrypoint. The daemon
      // service DO's liveness projection rides it (hosts.markSeen); the
      // provider-settings snapshot (agentSnapshot.get) serves any future
      // consumer split. Named entrypoints are unreachable from public
      // traffic — the binding IS the capability — so the retired
      // HOSTS_DB D1 binding needed no replacement secret.
      "binding": "CONTROL_PLANE",
      "service": "cap-server-worker",
      "entrypoint": "control_plane",
    },
  ],
  "r2_buckets": [
    {
      // #316 project attachment objects (key family
      // attachment/<projectId>/<sha256><ext>). Provision with
      // `wrangler r2 bucket create cap-server-attachments` before deploy.
      "binding": "BLOBS",
      "bucket_name": "cap-server-attachments",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NotificationHubDO",
        "LeaseStoreDO",
        "ComposedAgentDO",
        "ComposedHostOrchestratorDO",
        "ManagerDo",
        "DaemonServiceDO",
      ],
    },
    {
      // #581 additive class; existing deployments have already applied v1.
      "tag": "v2",
      "new_sqlite_classes": ["ComposedDurableAgentDO"],
    },
    {
      // The legacy agent loop, provider manager, and host orchestrator are
      // gone (#590). Retirement ran as a three-step deploy sequence (10061 →
      // 10064 → clean delete): bindings were swapped first (#605), then the
      // dormant classes were stub-exported (#606) so the pi-durable script
      // could ship; with zero references left on the live script, this
      // migration now deletes the dormant classes and their DO storage.
      "tag": "v3",
      "deleted_classes": ["ComposedAgentDO", "ComposedHostOrchestratorDO", "ManagerDo"],
    },
  ],
  "kv_namespaces": [
    {
      // Edge shield (#36): hostKey-hash auth cache for the composed daemon
      // face. Optional at runtime (env-key deployments skip it).
      "binding": "DAEMON_EDGE_KV",
      "id": "5b39e87d559b424a8f6432e6a2bc9ff7",
    },
  ],
  "triggers": {
    // Backstop sweep; per-item timing rides DO alarms (bb ran a 10s
    // in-process sweep).
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    // SEC-W5-001 (#397) fail-closed, #505: no gate flag — gate state IS the
    // ACCESS_TEAM_DOMAIN + ACCESS_AUD Worker secret pair (`wrangler secret
    // put`). Both present = JWT verification on /api/v1/* and /ws; either
    // missing = locked (503 access_gate_disabled) unless local-dev
    // (ACCESS_LOCAL_DEV, never set here). deploy-staging.sh asserts the pair.
    // #504: DATA_DIR retired — the display label is the named constant
    // BB_DATA_DIR_LABEL (shared/bb-display.ts), never a knob.
    // #377: no composition identity vars. The provider journal DO is named
    // by a code constant, the binding default is the cloud placeholder, and
    // a daemon enroll mints its own host — the deployment fabricates no
    // machine. #500: the former deployment-channel scalars (relay config,
    // machine pin, permission mode) are deleted — D1 rows/seats are the 正本.
  },
}
