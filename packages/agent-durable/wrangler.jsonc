{
  "name": "cap-agent-durable-test",
  "main": "test/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The drizzle-kit generated journal DDL (#602) is statically imported as
  // text by src/db/bootstrap.ts; the test worker bundles the same src tree.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_DO",
        "class_name": "TestDurableAgentDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TestDurableAgentDO"],
    },
  ],
}
