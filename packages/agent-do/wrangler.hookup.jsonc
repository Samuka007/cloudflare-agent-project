{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-do-hookup",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "AGENT_DO", "class_name": "AgentDO" },
      // The composed hookup: the REAL per-machine service DO (#30) — the
      // production binding shape — instead of the in-package fake.
      { "name": "DAEMON_SERVICE", "class_name": "DaemonServiceDO" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentDO", "DaemonServiceDO"] }],
  "kv_namespaces": [
    {
      // Edge shield (#36): hostKey-hash auth cache for the daemon face this
      // rig composes. Optional at runtime; bound here to match production.
      "binding": "DAEMON_EDGE_KV",
      "id": "5b39e87d559b424a8f6432e6a2bc9ff7",
    },
  ],
  // #398/SEC-W5-002: no plaintext credential vars — the daemon-face secrets
  // come from .dev.vars (gitignored, written by scripts/poc-full-chain.ts for
  // wrangler dev) or `wrangler secret put` for a deployed hookup worker.
  // The hookup vitest rig (vitest.hookup.config.ts) injects rig bindings.
}
