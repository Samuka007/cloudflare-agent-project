{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-do",
  "main": "src/worker.ts",
  // #560 thread-view direct-import: bb submodule sources bundle verbatim
  // (typecheck runs on ambient shims in @cap/agent-do — these aliases are the
  // runtime resolution; zod resolves through the root node_modules copy).
  "alias": {
    "@bb/domain": "../../../bb/packages/domain/src/index.ts",
    "@bb/thread-view": "../../../bb/packages/thread-view/src/index.ts",
    "@bb/thread-view/event-decode": "../../../bb/packages/thread-view/src/event-decode.ts",
    "@bb/thread-view/accepted-client-request-context": "../../../bb/packages/thread-view/src/accepted-client-request-context.ts",
  },
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "AGENT_DO", "class_name": "AgentDO" },
      { "name": "DAEMON_SERVICE", "class_name": "TestDaemonServiceDO" },
      // #197 D2: the rig's hub is the recording fixture — L2 asserts the
      // frames the agent DO pushes, not a socket fan-out (pool transport
      // cannot deliver server→client WS frames, see server-worker c4 FIXME).
      { "name": "HUB", "class_name": "RecordingHubDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AgentDO", "TestDaemonServiceDO"] },
    { "tag": "v2", "new_sqlite_classes": ["RecordingHubDO"] },
  ],
  // #238 L2: control-plane face for the terminal-turn settlement — the same
  // binding shape the composed worker gives the agent DO (worker `DB`).
  "d1_databases": [
    { "binding": "DB", "database_name": "agent-do-rig", "database_id": "local" },
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "agent-do-blobs" }],
}
