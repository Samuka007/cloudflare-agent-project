{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2024", "DOM"]
  },
  // l1-ws-close-reconnect exercises the REAL client session/socket wiring, so
