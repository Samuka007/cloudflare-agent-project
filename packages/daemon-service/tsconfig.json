{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["@cloudflare/workers-types"]
  },
  // The daemon client (src/client) is a plain Bun/Node process and is
  // typechecked against Node types separately (tsconfig.client.json) — the
  // Workers and Node ambient type sets overlap-and-conflict.
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": [
    "src/client/**",
    "test/tool-runtime.test.ts",
    "test/l1-ws-close-reconnect.test.ts",
    "test/l1-read-semantics.test.ts",
    "test/l1-glob-grep-semantics.test.ts",
    "test/l1-edit-semantics.test.ts",
    "test/l1-find-semantics.test.ts"
  ]
}
